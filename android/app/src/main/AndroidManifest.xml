<?xml version="1.0" encoding="utf-8"?>
<!--
  Greeblis Town - self-contained Meta Quest package.

  The whole game (one HTML file) ships inside this APK under assets/. On launch,
  LauncherActivity starts a loopback-only HTTP server that serves that file and
  opens it in the Meta Quest Browser's immersive WebXR activity, exactly the way
  Meta's own PWA packager does, but without any hosted website.

  Manifest values follow the Meta Quest Virtual Reality Checks (VRC.Quest.Packaging.1-4).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <!-- Required for any socket, including the loopback server that hands the
         game to the browser. Without it ServerSocket throws EACCES and the
         launcher crashes before anything is shown. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- VRC.Quest.Packaging.1 / .3: head tracking required, no phone-only features. -->
    <uses-feature
        android:name="android.hardware.vr.headtracking"
        android:required="${headtrackingRequired}"
        android:version="1" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Package visibility (Android 11+): we bind to the Quest Browser's Custom Tabs service. -->
    <queries>
        <package android:name="com.oculus.browser" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".GreeblisApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Translucent.NoTitleBar">

        <!-- VRC.Quest.Packaging.1 item 8 -->
        <meta-data
            android:name="com.oculus.supportedDevices"
            android:value="quest2|questpro|quest3|quest3s" />

        <activity
            android:name=".LauncherActivity"
            android:alwaysRetainTaskState="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="landscape">

            <!-- Placeholder; LauncherActivity.getLaunchingUrl() substitutes the live
                 loopback URL (the port can move if 17777 is taken). -->
            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="http://127.0.0.1:17777/" />

            <!-- Meta Quest: launch straight into WebXR (no 2D browser panel). -->
            <meta-data
                android:name="horizonos.pwa.APP_MODE"
                android:value="${appMode}" />

            <meta-data
                android:name="android.support.customtabs.trusted.FALLBACK_STRATEGY"
                android:value="customtabs" />
            <meta-data
                android:name="android.support.customtabs.trusted.SCREEN_ORIENTATION"
                android:value="landscape" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/colorPrimary" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR_DARK"
                android:resource="@color/colorPrimaryDark" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/navigationColor" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR_DARK"
                android:resource="@color/navigationColorDark" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_IMAGE_DRAWABLE"
                android:resource="@drawable/splash" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR"
                android:resource="@color/backgroundColor" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_FADE_OUT_DURATION"
                android:value="300" />
            <meta-data
                android:name="android.support.customtabs.trusted.FILE_PROVIDER_AUTHORITY"
                android:value="com.montgummery.greeblis.fileprovider" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- VRC.Quest.Packaging.1 item 7: immersive apps declare the VR category;
                     the 2D variant declares the 2D category instead (gradle -PappMode=2D). -->
                <category android:name="${oculusCategory}" />
            </intent-filter>
        </activity>

        <!-- Used by the browser-helper library when it needs to bring the launcher back. -->
        <activity android:name="com.meta.androidbrowserhelper.trusted.FocusActivity" />

        <!-- Hands the splash image to the browser (same mechanism as Meta's PWA template). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.montgummery.greeblis.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>
    </application>
</manifest>
