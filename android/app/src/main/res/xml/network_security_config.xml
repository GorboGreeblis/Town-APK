<?xml version="1.0" encoding="utf-8"?>
<!-- VRC.Quest.Packaging.4 asks for a declared network security configuration.
     The app itself makes no network requests; the only traffic is the Quest
     Browser fetching the bundled game from this app's loopback server. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
