#!/bin/sh
# Refuses a commit in which the game file, its two shipped copies, the compressed version and the root APK disagree,
# or in which the game file is not minified (RULES.md 12, 19, 20); since 4.0.64 the root APK must be the Store's
# Bubblewrap web app (B133), which holds no game.
# Install once per clone:  git config core.hooksPath tools/git-hooks
# The author's rules: the game has one source, tools/uncompressed.html, edited directly; it ships as index.html at
# the repository root and as the APK's asset (tools/sync_game.py copies it; --check compares), and the APK at the
# root is always the latest build.
ROOT="$(git rev-parse --show-toplevel)"
ASSET="$ROOT/tools/site/index.html"
if git diff --cached --name-only | grep -qE '^(index\.html|GreeblisTown-release\.apk|tools/site/index\.html|tools/uncompressed\.html|index\.compressed\.html|tools/game_version\.txt)$'; then
  if ! python3 -I "$ROOT/tools/sync_game.py" --check >/dev/null 2>&1; then
    # the final (Store) build ships the game file with the debug code taken out (RULES.md 34, tools/build.sh --final):
    # the copies must then be exactly what final_build.js makes of the game file now (made again here to compare)
    FIN=$(mktemp -d)/final.html
    if ! { node "$ROOT/tools/final_build.js" "$ROOT/tools/uncompressed.html" --out "$FIN" >/dev/null 2>&1 \
           && python3 -I "$ROOT/tools/sync_game.py" --check --src "$FIN" >/dev/null 2>&1; }; then
      echo "pre-commit: index.html or the APK's asset differs from the game file tools/uncompressed.html" >&2
      echo "            (and from its final build, tools/final_build.js)." >&2
      echo "            Run: python3 tools/sync_game.py && git add index.html tools/site/index.html" >&2
      echo "            or, for the final build: tools/build.sh --bump --final" >&2
      rm -rf "$(dirname "$FIN")"; exit 1
    fi
    rm -rf "$(dirname "$FIN")"; FINAL=1
  fi
  if ! node "$ROOT/tools/minify_game.js" --check >/dev/null 2>&1; then
    echo "pre-commit: the game file tools/uncompressed.html is not fully minified (RULES.md 19). Run: tools/build.sh --bump" >&2
    exit 1
  fi
  if [ -z "$FINAL" ] && ! node "$ROOT/tools/build_compressed.js" --check >/dev/null 2>&1; then
    echo "pre-commit: index.compressed.html does not unpack to the current game file (RULES.md 20). Run: tools/build.sh --bump" >&2
    exit 1
  fi
  # since 4.0.64 (B133) the root APK holds no game: it is the Store's Bubblewrap web app opening the hosted site
  # (tools/build_twa.sh); it must be that kind of APK and the version in tools/twa/twa-manifest.json
  if unzip -l "$ROOT/GreeblisTown-release.apk" 2>/dev/null | grep -q 'assets/index.html'; then
    echo "pre-commit: GreeblisTown-release.apk at the root is the old self-contained APK; the Store takes only the" >&2
    echo "            Bubblewrap web app (B133). Build it: tools/build_twa.sh" >&2
    exit 1
  fi
fi
exit 0
